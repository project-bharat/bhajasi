  "type": "अनुक्रमणिका",
  "description": "४५८३ अभंगांचा हा संग्रह वाचनासाठी १५०-१५० अभंगांच्या सोयीस्कर भागांत मांडला आहे.",
  "totalEntries": 4583,
  "partSize": 150,
  "themes": [
    {
      "id": "karuna-rasa",
      "title": "करुणा रसाचे अभंग",
      "type": "करुणा",
      "description": "दीनता, आर्तता, दुःख, विरह आणि भगवंताविषयीची करुण आळवणी व्यक्त करणारे अभंग."
    },
    {
      "id": "upadesh",
      "title": "उपदेशपर वचने",
      "type": "उपदेश",
      "description": "नीती, सदाचार, आत्मशुद्धी, भक्ती आणि जीवनविषयक मार्गदर्शन करणारे अभंग."
    },
    {
      "id": "vitthal-bhakti",
      "title": "विठ्ठल भक्ती",
      "type": "भक्ती",
      "description": "विठ्ठलावरील प्रेम, भक्ती, नामस्मरण आणि भक्त-भगवंत संबंध व्यक्त करणारे अभंग."
    },
    {
      "id": "pandurang-alavani",
      "title": "पांडुरंग आळवणी",
      "type": "आळवणी",
      "description": "पांडुरंगाला हाक मारणारे, दर्शनाची आस व्यक्त करणारे आणि भगवंताचे स्मरण करणारे अभंग."
    },
    {
      "id": "namamahatmya",
      "title": "नाममाहात्म्य पर अभंग",
      "type": "नाममाहात्म्य",
      "description": "भगवंताच्या नामाचे महत्त्व, नामस्मरणाची साधना आणि नामाची फलश्रुती सांगणारे अभंग."
    },
    {
      "id": "sant-mahima",
      "title": "संत महिमा व साधुसंगती",
      "type": "संत महिमा",
      "description": "संतांचे महत्त्व, संतसंग, साधुसंगती आणि संतांच्या मार्गदर्शनाचे महत्त्व सांगणारे अभंग."
    },
    {
      "id": "pakhand-khandan",
      "title": "पाखंड खंडन व ढोंग विदारण",
      "type": "पाखंड खंडन",
      "description": "ढोंग, दांभिकपणा, पाखंड, कर्मकांडातील दिखावा आणि खोट्या आध्यात्मिकतेवर प्रहार करणारे अभंग."
    },
    {
      "id": "gaulani-krishna",
      "title": "गौळणी व कृष्णलीला",
      "type": "गौळणी • कृष्णलीला",
      "description": "कृष्णलीला, गोपिका, गोकुळ, बालकृष्ण आणि कृष्णभक्तीशी संबंधित अभंग."
    },
    {
      "id": "samsar-vairagya",
      "title": "संसार-वैराग्य व नश्वरता",
      "type": "वैराग्य",
      "description": "संसाराचे क्षणभंगुर स्वरूप, मोह-माया, वैराग्य आणि जगाच्या नश्वरतेचे चिंतन करणारे अभंग."
    },
    {
      "id": "atmanivedan",
      "title": "आत्मनिवेदन व स्वानुभव",
      "type": "आत्मनिवेदन",
      "description": "स्वतःचे आध्यात्मिक अनुभव, आत्मपरीक्षण, आत्मनिवेदन आणि अंतर्मुख चिंतन व्यक्त करणारे अभंग."
    },
    {
      "id": "prarthana-kritajnata",
      "title": "प्रार्थना व कृतज्ञता",
      "type": "कृतज्ञता",
      "description": "भगवंताकडे केलेली प्रार्थना, शरणागती, कृपेसाठी विनंती आणि प्राप्त कृपेबद्दलची कृतज्ञता व्यक्त करणारे अभंग."
    }
  ],
